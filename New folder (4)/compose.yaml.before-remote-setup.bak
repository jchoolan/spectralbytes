name: spectralbytes-new

services:
  ctfd:
    image: spectralbytes-ctfd:postgres
    restart: unless-stopped
    ports:
      - "127.0.0.1:8090:8000"
    environment:
      DATABASE_URL: postgresql+psycopg2://ctfd:${CTFD_DB_PASSWORD}@db:5432/ctfd
      REDIS_URL: redis://cache:6379
      SECRET_KEY: ${CTFD_SECRET_KEY}
      WORKERS: "1"
    depends_on:
      db:
        condition: service_healthy
      cache:
        condition: service_started
    volumes:
      - ctfd_uploads:/var/uploads
      - ctfd_logs:/var/log/CTFd
    networks:
      - control

  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ctfd
      POSTGRES_USER: ctfd
      POSTGRES_PASSWORD: ${CTFD_DB_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ctfd -d ctfd"]
      interval: 10s
      timeout: 5s
      retries: 15
    networks:
      - control

  cache:
    image: redis:7.2-alpine
    restart: unless-stopped
    networks:
      - control

  s01:
    build:
      context: ./challenges/s01
      dockerfile: Dockerfile
    image: spectralbytes-s01:latest
    container_name: spectralbytes-new-s01
    restart: unless-stopped
    ports:
      - "127.0.0.1:2231:22"
    networks:
      - challenge_s01
    pids_limit: 128
    mem_limit: 256m
    cpus: 0.5

  s02:
    build:
      context: ./challenges/s02
      dockerfile: Dockerfile
    image: spectralbytes-s02:latest
    container_name: spectralbytes-new-s02
    restart: unless-stopped
    ports:
      - "127.0.0.1:2232:22"
    networks:
      - challenge_s02
    pids_limit: 128
    mem_limit: 256m
    cpus: 0.5

  s03:
    build:
      context: ./challenges/s03
      dockerfile: Dockerfile
    image: spectralbytes-new-s03:latest
    container_name: spectralbytes-new-s03
    restart: unless-stopped
    ports:
      - "127.0.0.1:2233:22"
    networks:
      - challenge_s03
    pids_limit: 128
    mem_limit: 256m
    cpus: 0.5

  s04:
    build:
      context: ./challenges/s04
      dockerfile: Dockerfile
    image: spectralbytes-s04-v2:latest
    container_name: spectralbytes-new-s04
    restart: unless-stopped
    ports:
      - "127.0.0.1:2234:22"
    networks:
      - challenge_s04
    security_opt:
      - no-new-privileges:true
    pids_limit: 128

  s05:
    build:
      context: ./challenges/s05
      dockerfile: Dockerfile
    image: spectralbytes-new-s05:latest
    container_name: spectralbytes-new-s05
    restart: unless-stopped
    ports:
      - "127.0.0.1:8055:5000"
    networks:
      - challenge_s05
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,size=16m
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    pids_limit: 128

  s06:
    build:
      context: ./challenges/s06
      dockerfile: Dockerfile
    image: spectralbytes-new-s06:latest
    container_name: spectralbytes-new-s06
    hostname: spectralbytes-s06
    restart: unless-stopped
    networks:
      - challenge_s06
    pids_limit: 128
    mem_limit: 256m
    cpus: 0.5
    security_opt:
      - no-new-privileges:false

  s06-proxy:
    image: alpine/socat
    container_name: spectralbytes-new-s06-proxy
    restart: unless-stopped
    command:
      - TCP-LISTEN:2236,fork,reuseaddr
      - TCP:s06:22
    ports:
      - "127.0.0.1:2236:2236"
    networks:
      - challenge_s06
      - s06_ingress
    depends_on:
      - s06
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    pids_limit: 64
    mem_limit: 64m

networks:
  control:
    driver: bridge

  challenge_s01:
    driver: bridge

  challenge_s02:
    driver: bridge

  challenge_s03:
    driver: bridge

  challenge_s04:
    driver: bridge
    internal: false

  challenge_s05:
    driver: bridge

  challenge_s06:
    driver: bridge
    internal: true

  s06_ingress:
    driver: bridge

volumes:
  ctfd_uploads:
  ctfd_logs:
  postgres_data:

